<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>0.1.1</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <COI_ROOT Condition="'$(COI_ROOT)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Captain of Industry</COI_ROOT>
    <GameManaged>$(COI_ROOT)\Captain of Industry_Data\Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <Reference Include="Mafi">
      <HintPath>$(GameManaged)\Mafi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Core">
      <HintPath>$(GameManaged)\Mafi.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Unity">
      <HintPath>$(GameManaged)\Mafi.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(GameManaged)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(GameManaged)\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Update="manifest.json;config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManaged)\Mafi.Unity.dll')" Text="Set COI_ROOT to your installed Captain of Industry folder." />
  </Target>
</Project>
